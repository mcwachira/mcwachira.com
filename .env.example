# GitHub Writing Repository Configuration
# Required: Owner and name of the repository containing Markdown articles
WRITING_REPO_OWNER=your-github-username
WRITING_REPO_NAME=mcwachira-writing
WRITING_REPO_BRANCH=main

# Optional: GitHub Personal Access Token for private repositories
# If the repository is public, this is not required
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Supabase Configuration (keep existing for projects, auth, etc.)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Resend Configuration (for contact form)
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_NOTIFICATION_EMAIL=your-email@example.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google GenAI (for Site QA feature)
GOOGLE_GENAI_API_KEY=your-google-genai-api-key